      ],
      "id": "0072adef-b5ac-487b-a035-c68d0152b0ca",
      "name": "Deal Notes",
      "credentials": {
        "hubspotAppToken": {
          "id": "DK6aUhoyZ42IbfNM",
          "name": "Impressive Batterie's Hubspot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const src = $('Exactly One Deal').first();\nconst out = [];\nfor (const n of $input.first().json.results || []) for (const f of String(n.properties.hs_attachment_ids || '').split(';').filter(Boolean)) out.push({ json: { fileId: f } });\nreturn out.length ? out.slice(0, 80) : [{ json: { fileId: 'none' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
