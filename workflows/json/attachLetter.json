          "id": "DK6aUhoyZ42IbfNM",
          "name": "Impressive Batterie's Hubspot"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const src = $('Exactly One Deal').first();\nconst norm = (s) => String(s || '').toLowerCase().replace(/\\.pdf$/, '').replace(/[^a-z0-9]+/g, ' ').trim();\nconst want = norm(src.json.fileName);\nconst have = $input.all().map((f) => norm((f.json.name || '') + (f.json.extension ? '.' + f.json.extension : '')));\nconst duplicate = have.includes(want);\n// testOnly (test harness): report and stop before any write.\nif (src.json.testOnly) return [{ json: { testOnly: true, duplicate, dealId: src.json.dealId, checked: have.length } }];\nif (duplicate) return [];\nreturn [src];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
