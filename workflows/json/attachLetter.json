      "id": "69bd369f-af7d-421c-ae82-1aa0a941d5e2",
      "name": "Find Deal By NMI",
      "credentials": {
        "hubspotAppToken": {
          "id": "DK6aUhoyZ42IbfNM",
          "name": "Impressive Batterie's Hubspot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n$input.all().forEach((item) => {\n  const src = $('When Called').first();\n  const hits = (item.json.results || []).filter((d) => String(d.properties.nmi || '').toUpperCase().replace(/\\s/g, '').startsWith(src.json.nmi10));\n  if (hits.length !== 1) throw new Error('Network letter NMI ' + src.json.nmi + ' (' + src.json.distributor + ', ref ' + src.json.reference + ', file ' + src.json.fileName + ') matched ' + hits.length + ' deals in the pipeline; attach it by hand');\n  out.push({ json: { ...src.json, dealId: String(hits[0].id), deal: hits[0].properties }, binary: src.binary });\n});\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "id": "b5fab37e-6fe6-401e-a08e-471acf3c5348",
