        "jsCode": "const out = [];\nfor (const item of $input.all().slice(0, 10)) {\n  const j = item.json;\n  const subject = j.subject || j.Subject || j.headers?.subject || '';\n  const m = String(subject).match(/\\b(\\d{6,})\\b/);\n  out.push({ json: { messageId: j.id, subject, dealId: m ? m[1] : null } });\n}\nreturn out;"
      },
